# ShardKV Configuration
# Copy this file to .env and modify as needed

# Node identification
SHARD_NODE_ID=1
SHARD_LISTEN_ADDR=0.0.0.0:7070
SHARD_PEERS=localhost:7071,localhost:7072

# Storage paths
SHARD_DATA_DIR=/var/shard/data
SHARD_WAL_DIR=/var/shard/wal

# MemTable configuration
SHARD_MEMTABLE_SIZE_MB=64

# Bloom filter false positive rate (0.0 - 1.0)
SHARD_BLOOM_FP_RATE=0.01

# Compaction settings
SHARD_COMPACTION_ENABLED=true
SHARD_LEVEL_SIZE_MULTIPLIER=10

# Raft timeouts (milliseconds)
SHARD_ELECTION_TIMEOUT_MIN_MS=150
SHARD_ELECTION_TIMEOUT_MAX_MS=300
SHARD_HEARTBEAT_MS=50
SHARD_RPC_TIMEOUT_MS=100

# Logging
SHARD_LOG_LEVEL=INFO
